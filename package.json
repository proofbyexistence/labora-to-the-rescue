{
  "name": "labora-campus-lab-notebook",
  "version": "1.0.0",
  "description": "LABORA (LabLink): Every lab. One notebook. Campus laboratory equipment discovery, smart slot booking, access requests, and faculty approvals.",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build",
    "start": "node server.ts",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit --noUnusedLocals --noUnusedParameters",
    "lint:eslint": "eslint .",
    "format": "prettier --write \"**/*.{ts,tsx,js,css,md,json}\"",
    "test": "node --import tsx --test tests/*.test.js"
  },
  "dependencies": {
    "@google/genai": "2.32.0",
    "@tailwindcss/vite": "4.3.5",
    "@vitejs/plugin-react": "6.3.0",
    "dotenv": "17.4.2",
    "express": "4.22.3",
    "lucide-react": "0.546.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "vite": "8.3.8"
  },
  "devDependencies": {
    "@types/express": "4.17.25",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "tailwindcss": "4.3.5",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  }
}
